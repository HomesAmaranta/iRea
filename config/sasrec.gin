# SASRec SID training configuration for iRea.
# Run: python -m trainers.general_trainer config/sasrec.gin --split beauty
include "config/base.gin"

import data.amazon
import models.sasrec

train.model_name = "sasrec"

# Training settings from the original SASRec config
train.epochs = 300
train.batch_size = 128
train.learning_rate = 1e-3
train.weight_decay = 0.0

# Default model structure; the SID interface always uses NTP cross-entropy
train.max_seq_len = 20
train.embed_dim = 128
train.num_heads = 4
train.num_blocks = 4
train.ffn_dim = 256
train.dropout = 0.1

# Shared TIGER sliding-window SID data
train.dataset = @AmazonSeqDataset
train.dataset_folder = "dataset/amazon"
train.codebook_size = 256
train.sem_id_dim = 3
AmazonSeqDataset.split = "{split}"
AmazonSeqDataset.encoder_model_name = %MODEL_HUB_SENTENCE_T5_XL
AmazonSeqDataset.add_disambiguation = False
AmazonSeqDataset.rqvae_input_dim = 768
AmazonSeqDataset.rqvae_embed_dim = 32
AmazonSeqDataset.rqvae_hidden_dims = [512, 256, 128, 64]
AmazonSeqDataset.rqvae_codebook_size = 256
AmazonSeqDataset.rqvae_n_layers = 3
train.pretrained_rqvae_path = "out/tiger/amazon/{split}/rqvae/checkpoint_epoch_4999.pt"

# General trainer equivalents of the original evaluation settings
train.eval_valid_every_n_epochs = 1
train.infer_batch_size = 256
train.early_stop_patience = 50
train.beam_size = 30
train.save_dir_root = "out/sasrec/amazon/{split}/sid"
train.wandb_logging = True
train.wandb_project = "sasrec_{split}_training"
train.wandb_log_interval = 100
train.mixed_precision = "bf16"
