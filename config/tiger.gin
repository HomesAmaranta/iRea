# TIGER config for Amazon dataset
# Uses HuggingFace T5ForConditionalGeneration (paper-aligned reference implementation)
# Plain Adam, lr=1e-4, no scheduler, max_seq_len=20

include "config/base.gin"

import data.amazon
import models.tiger

# Training settings (plain Adam, no scheduler - best config)
train.epochs=200
train.learning_rate=1e-4
train.weight_decay=0.0
train.batch_size=256
train.infer_batch_size=256
train.beam_size=30
train.early_stop_patience=10
train.early_stop_metric="ce"
train.eval_test_every_epoch=2

# Model architecture (HF T5 config)
train.num_layers=4
train.num_decoder_layers=4
train.d_model=128
train.d_ff=1024
train.num_heads=6
train.d_kv=64
train.dropout_rate=0.1
train.feed_forward_proj='relu'

# Optional current-item fusion; none keeps the original TIGER behavior.
# add: h + MLP(emb); concat: MLP([h, emb]).
# out: decoder start output only; attn: final decoder self-attention start K/V.
train.fusion_mode="none"  # none | add | concat
train.fusion_position="out"  # out | attn

# NITP: detached next-token decoder block output, one-based layer index.
train.nitp_weight=0.0
train.nitp_target_layer=1  # try 1 | 2 | 3 independently

# Data config
train.codebook_size=256
train.sem_id_dim=3
train.max_seq_len=20

# Dataset
train.dataset=@AmazonSeqDataset
train.dataset_folder="dataset/amazon"
AmazonSeqDataset.split="{split}"
AmazonSeqDataset.encoder_model_name=%MODEL_HUB_SENTENCE_T5_XL
AmazonSeqDataset.add_disambiguation=False

# RQVAE config (must match pretrained model)
AmazonSeqDataset.rqvae_input_dim=768
AmazonSeqDataset.rqvae_embed_dim=32
AmazonSeqDataset.rqvae_hidden_dims=[512, 256, 128, 64]
AmazonSeqDataset.rqvae_codebook_size=256
AmazonSeqDataset.rqvae_n_layers=3

# Pretrained RQVAE checkpoint path
train.pretrained_rqvae_path="./out/tiger/amazon/{split}/rqvae/checkpoint_epoch_4999.pt"

# Output
train.save_dir_root="out/tiger/amazon/{split}/"

# Logging
train.wandb_logging=True
train.wandb_project="tiger_{split}_training"
train.wandb_log_interval=10
