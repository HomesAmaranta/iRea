# Base configuration for iRea
# This file defines common macros for model paths.
#
# You can override these paths in two ways:
# 1. Set environment variables before running:
#    export MODEL_HUB=/path/to/your/models
#    Then use: MODEL_HUB_SENTENCE_T5_XL = "${MODEL_HUB}/sentence-t5-xl"
#
# 2. Override via command line:
#    --gin "MODEL_HUB_SENTENCE_T5_XL='/your/path/sentence-t5-xl'"
#
# Default values use HuggingFace model identifiers for automatic download.

# Sentence-T5 models (for text encoding)
MODEL_HUB_SENTENCE_T5_BASE = "/opt/tiger/project/hf_models/sentence-t5-base"
MODEL_HUB_SENTENCE_T5_XL = "/opt/tiger/project/hf_models/sentence-t5-xl"

# OneRec RQ-KMeans item encoder
MODEL_HUB_QWEN3_EMBEDDING_8B = "/opt/tiger/project/hf_models/Qwen3-Embedding-8B"

# LCRec / OneRec recommendation backbone (not the item encoder).
MODEL_HUB_QWEN3_06B = "/opt/tiger/project/hf_models/Qwen3-0.6B"
MODEL_HUB_QWEN3_17B = "/opt/tiger/project/hf_models/Qwen3-1.7B"
